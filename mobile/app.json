{
  "expo": {
    "name": "AI Acquisition Search",
    "slug": "ai-acquisition-search",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "aiacquisitionsearch",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ecpulse.aiacquisitionsearch",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ecpulse.aiacquisitionsearch",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0c"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080809",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "webAppUrl": "https://ai-acquisition-search-naitoshyuichirou-6935.vercel.app"
    },
    "backgroundColor": "#080809",
    "primaryColor": "#080809"
  }
}
